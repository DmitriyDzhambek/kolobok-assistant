# ═══════════════════════════════════════════════════════════════
# Колобок —MarketDataAggregator: образец переменных окружения
# Скопируйте в .env (он в .gitignore) и заполните своими ключами.
# НИКОГДА не коммитьте .env в git!
# ═══════════════════════════════════════════════════════════════

# --- Серверная часть (backend/market_proxy.py) ---
# Токен Тинькофф Инвестиций: создаётся в настройках профиля →
# «Информация и сервисы» → «Токены» (права: portfolio/investments, read-only).
# Срок жизни — 365 дней; отзывается в любой момент тем же экраном.
TINKOFF_INVEST_TOKEN=t.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ключ API экономического календаря (finlux / Trading Economics и т.п.)
ECON_CALENDAR_API_KEY=xxxxxxxxxxxxxxxx

# Секрет подписи короткоживущих JWT-сессий (любая длинная случайная строка)
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_SECRET=xxxxxxxxxxxxxxxx

# --- Клиент (только публичные значения, БЕЗ секретов!) ---
# Адрес нашего thin-proxy. Ключи туда уезжают на сервере, в браузере их нет.
VITE_MARKET_PROXY_URL=/api/market

# Флаг mock-режима для разработки/демо (правда = не ходить в реальные API)
VITE_USE_MOCK_MARKET=true
